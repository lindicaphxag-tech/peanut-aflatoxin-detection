/* pages/about/about.wxss */

.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: calc(24rpx + env(safe-area-inset-top)) 0 8rpx;
}
.brand { display: flex; align-items: center; }
.brand-mark {
  width: 44rpx; height: 44rpx; border-radius: 14rpx;
  background: linear-gradient(150deg, #e8c68a, #a97a33);
  display: flex; align-items: center; justify-content: center;
}
.bm-dot { width: 14rpx; height: 22rpx; border-radius: 8rpx; background: #241a10; }
.brand-text { margin-left: 14rpx; font-size: 24rpx; letter-spacing: 4rpx; color: #e6d6bd; font-weight: 600; }
.chip { padding: 8rpx 18rpx; border-radius: 999rpx; border: 1rpx solid var(--line); }
.chip-text { font-size: 21rpx; color: var(--muted); }

.page-head { margin: 18rpx 0 6rpx; }
.h1 { display: block; font-size: 44rpx; font-weight: 700; color: #fbf3e6; }
.h2 { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--muted-2); }

.card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 26rpx; }
.card-t { display: block; font-size: 27rpx; color: #f3e7d5; font-weight: 600; }
.card-c { display: block; margin-top: 12rpx; font-size: 23rpx; color: var(--muted); line-height: 1.8; }

.metric-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.metric {
  width: calc(50% - 8rpx);
  padding: 26rpx 20rpx;
  border-radius: 24rpx;
  display: flex; flex-direction: column; align-items: flex-start;
}
.metric-n { font-size: 46rpx; font-weight: 700; color: var(--gold); letter-spacing: 1rpx; }
.metric-k { margin-top: 8rpx; font-size: 21rpx; color: var(--muted-2); }
.t-ok { color: var(--jade) !important; }
.metric-note { display: block; margin-top: 16rpx; font-size: 20rpx; color: var(--muted-2); line-height: 1.7; }

.kv { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid rgba(217, 178, 106, 0.1); }
.kv:last-child { border-bottom: none; }
.k { font-size: 23rpx; color: var(--muted-2); }
.v { font-size: 23rpx; color: #e8dbc7; }

.flow { padding: 6rpx 0; }
.flow-item { display: flex; align-items: center; }
.flow-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--gold-deep);
  box-shadow: 0 0 14rpx rgba(224, 187, 122, 0.5);
  margin-right: 20rpx;
  flex: 0 0 auto;
}
.flow-t { font-size: 23rpx; color: var(--muted); }
.flow-line { width: 2rpx; height: 26rpx; margin-left: 7rpx; background: linear-gradient(180deg, rgba(224, 187, 122, 0.45), transparent); }

.footer { margin-top: 40rpx; text-align: center; }
.footer-1 { font-size: 20rpx; color: var(--muted-2); }


/* ===== 阈值设置 ===== */
.sl-row { margin-top: 26rpx; }
.sl-head { display: flex; justify-content: space-between; align-items: baseline; }
.sl-k { font-size: 23rpx; color: var(--muted); }
.sl-v { font-size: 26rpx; color: var(--gold); font-weight: 700; }
.sl { margin: 6rpx 0 0; padding: 0; }
.th-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.th-btn {
  flex: 1; height: 84rpx; line-height: 84rpx; text-align: center;
  border-radius: 999rpx; font-size: 25rpx;
}
.th-btn.ghost { color: var(--muted); border: 1rpx solid var(--line-strong); }
.th-btn.main { color: #2b1d10; font-weight: 700; background: linear-gradient(135deg, #f2d8a8, #a97a33); }
.th-btn.is-dim { opacity: 0.55; }
.th-note { display: block; margin-top: 20rpx; font-size: 20rpx; color: var(--muted-2); line-height: 1.7; }
