/* pages/knowledge/knowledge.wxss */

.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: calc(24rpx + env(safe-area-inset-top)) 0 8rpx;
}
.brand { display: flex; align-items: center; }
.brand-mark {
  width: 44rpx; height: 44rpx; border-radius: 14rpx;
  background: linear-gradient(150deg, #e8c68a, #a97a33);
  display: flex; align-items: center; justify-content: center;
}
.bm-dot { width: 14rpx; height: 22rpx; border-radius: 8rpx; background: #241a10; }
.brand-text { margin-left: 14rpx; font-size: 24rpx; letter-spacing: 4rpx; color: #e6d6bd; font-weight: 600; }

.page-head { margin: 18rpx 0 6rpx; }
.h1 { display: block; font-size: 42rpx; font-weight: 700; color: #fbf3e6; line-height: 1.35; }
.h2 { display: block; margin-top: 12rpx; font-size: 22rpx; color: var(--muted-2); }

.alert {
  display: flex; margin-top: 26rpx; padding: 26rpx;
  border-color: rgba(255, 122, 99, 0.32);
  background: linear-gradient(135deg, rgba(255, 122, 99, 0.13), rgba(255, 122, 99, 0.03));
}
.alert-bar { width: 6rpx; border-radius: 4rpx; margin-right: 20rpx; background: linear-gradient(180deg, var(--danger), transparent); }
.alert-body { flex: 1; }
.alert-t { display: block; font-size: 26rpx; color: #ffb3a6; font-weight: 600; }
.alert-c { display: block; margin-top: 10rpx; font-size: 23rpx; color: var(--muted); line-height: 1.7; }

.card { margin-bottom: 18rpx; padding: 26rpx; border-radius: 26rpx; }
.card-t { display: block; font-size: 27rpx; color: #f3e7d5; font-weight: 600; }
.card-c { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--muted); line-height: 1.8; }
.em { color: var(--gold); font-style: italic; }

.tags { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.tag {
  padding: 10rpx 22rpx; border-radius: 999rpx;
  font-size: 22rpx; color: #e3d2b6;
  background: rgba(224, 187, 122, 0.10);
  border: 1rpx solid rgba(224, 187, 122, 0.22);
}

/* 3D 翻转卡 */
.flip-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.flip { width: calc(50% - 16rpx); height: 232rpx; perspective: 900rpx; }
.flip-inner {
  position: relative; width: 100%; height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}
.flip-on .flip-inner { transform: rotateY(180deg); }
.flip-face {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  border-radius: 24rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  padding: 20rpx;
}
.flip-front { }
.flip-back { transform: rotateY(180deg); }
.toxin-name { font-size: 40rpx; font-weight: 700; color: var(--gold); letter-spacing: 2rpx; }
.toxin-tag { margin-top: 12rpx; font-size: 21rpx; color: var(--muted-2); }
.toxin-back-t { font-size: 26rpx; color: var(--gold); font-weight: 600; }
.toxin-back-c { margin-top: 12rpx; font-size: 21rpx; color: var(--muted); line-height: 1.7; text-align: center; }

/* 表格 */
.table { margin-top: 6rpx; }
.tr { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid rgba(217, 178, 106, 0.12); }
.tr:last-child { border-bottom: none; }
.th .td1, .th .td2 { color: var(--muted-2); font-size: 21rpx; letter-spacing: 1rpx; }
.td1 { font-size: 24rpx; color: #e8dbc7; }
.td2 { font-size: 24rpx; color: var(--gold); }
.note { display: block; margin-top: 16rpx; font-size: 20rpx; color: var(--muted-2); }

/* 流程 */
.steps { margin-top: 20rpx; }
.step { display: flex; align-items: center; padding: 12rpx 0; }
.step-n {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 1rpx solid rgba(224, 187, 122, 0.4);
  font-size: 20rpx; color: var(--gold);
  display: flex; align-items: center; justify-content: center;
  margin-right: 18rpx;
}
.step-t { font-size: 23rpx; color: var(--muted); }

/* 预防 */
.tip { display: flex; align-items: flex-start; padding: 14rpx 0; }
.tip-n { font-size: 22rpx; color: var(--gold-deep); margin-right: 18rpx; letter-spacing: 1rpx; }
.tip-t { flex: 1; font-size: 23rpx; color: var(--muted); line-height: 1.7; }

.ref { margin-top: 26rpx; padding: 24rpx; border-radius: 24rpx; }
.ref-t { display: block; font-size: 22rpx; color: var(--muted-2); letter-spacing: 2rpx; }
.ref-c { display: block; margin-top: 10rpx; font-size: 20rpx; color: var(--muted-2); }

.footer { margin-top: 40rpx; text-align: center; }
.footer-1 { font-size: 20rpx; color: var(--muted-2); }
