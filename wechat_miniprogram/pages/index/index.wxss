/* pages/index/index.wxss —— 2026 视觉改版：深墨 + 金 + 全息 3D */

/* ============ 顶栏 ============ */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(24rpx + env(safe-area-inset-top)) 0 8rpx;
}
.brand { display: flex; align-items: center; }
.brand-mark {
  width: 44rpx; height: 44rpx; border-radius: 14rpx;
  background: linear-gradient(150deg, #e8c68a, #a97a33);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(224, 187, 122, 0.28);
}
.bm-dot { width: 14rpx; height: 22rpx; border-radius: 8rpx; background: #241a10; }
.brand-text { margin-left: 14rpx; font-size: 24rpx; letter-spacing: 4rpx; color: #e6d6bd; font-weight: 600; }

.chip {
  display: flex; align-items: center;
  padding: 8rpx 18rpx; border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.04);
}
.chip-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 10rpx; }
.chip-text { font-size: 22rpx; color: var(--muted); }
.chip-on .chip-dot { background: var(--jade); box-shadow: 0 0 12rpx var(--jade); }
.chip-off .chip-dot { background: var(--danger); box-shadow: 0 0 12rpx var(--danger); }
.chip-wait .chip-dot { background: var(--warn); box-shadow: 0 0 12rpx var(--warn); animation: blink 1.2s infinite; }
@keyframes blink { 50% { opacity: 0.25; } }

/* ============ 3D 全息舞台 ============ */
.hero { padding-top: 10rpx; }
.stage {
  position: relative;
  height: 400rpx;
  perspective: 1000rpx;
  perspective-origin: 50% 42%;
}
.hologram {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  transform-style: preserve-3d;
}

.disc {
  position: absolute;
  left: 50%; top: 52%;
  border-radius: 50%;
  transform-style: preserve-3d;
}
.disc-a {
  width: 380rpx; height: 380rpx; margin: -190rpx 0 0 -190rpx;
  border: 2rpx solid rgba(224, 187, 122, 0.30);
  background: repeating-conic-gradient(from 0deg, rgba(224, 187, 122, 0.30) 0deg 0.9deg, transparent 0.9deg 30deg);
  transform: rotateX(74deg);
  animation: spin 16s linear infinite;
  opacity: 0.75;
}
.disc-b {
  width: 288rpx; height: 288rpx; margin: -144rpx 0 0 -144rpx;
  border: 2rpx dashed rgba(88, 201, 163, 0.55);
  transform: rotateX(74deg);
  animation: spin-r 11s linear infinite;
  opacity: 0.7;
}
.disc-c {
  width: 240rpx; height: 110rpx; margin: -55rpx 0 0 -120rpx;
  background: radial-gradient(ellipse at center, rgba(224, 187, 122, 0.30), transparent 70%);
  filter: blur(10rpx);
  transform: rotateX(74deg);
  animation: pulse 3.6s ease-in-out infinite;
}
@keyframes spin { from { transform: rotateX(74deg) rotateZ(0deg); } to { transform: rotateX(74deg) rotateZ(360deg); } }
@keyframes spin-r { from { transform: rotateX(74deg) rotateZ(360deg); } to { transform: rotateX(74deg) rotateZ(0deg); } }
@keyframes pulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 0.95; } }

.beam {
  position: absolute; left: 50%; top: 30%;
  width: 420rpx; height: 260rpx; margin-left: -210rpx;
  background: radial-gradient(ellipse at center, rgba(224, 187, 122, 0.18), rgba(224, 187, 122, 0.05) 45%, transparent 72%);
  animation: beamFade 4s ease-in-out infinite;
}
@keyframes beamFade { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.9; } }

/* 花生本体：纯 CSS 造型，避免 emoji 跨端渲染差异 */
.peanut-float {
  position: absolute; left: 50%; top: 8%;
  width: 180rpx; height: 250rpx; margin-left: -90rpx;
  animation: float 4.2s ease-in-out infinite;
  transform-style: preserve-3d;
}
@keyframes float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-16rpx) rotate(2deg); }
}
.peanut {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  transform: rotate(-10deg);
  filter: drop-shadow(0 20rpx 26rpx rgba(0, 0, 0, 0.55));
}
.lobe {
  position: absolute; left: 8rpx;
  width: 172rpx; height: 120rpx;
  border-radius: 50% / 50%;
  background:
    radial-gradient(circle at 34% 26%, rgba(255, 244, 222, 0.85), transparent 40%),
    linear-gradient(150deg, #eed09b 0%, #cf9d55 52%, #92682c 100%);
  transform: rotate(-14deg);
}
.lobe-top { top: 10rpx; }
.lobe-bottom { bottom: 10rpx; }
.waist {
  position: absolute; left: 46rpx; top: 88rpx;
  width: 96rpx; height: 74rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #e7c68e 0%, #c8964f 55%, #8f6529 100%);
  transform: rotate(-14deg);
  filter: blur(0.6rpx);
}
.shell {
  position: absolute; top: 14rpx; bottom: 14rpx; left: 26rpx; right: 26rpx;
  border-radius: 46%;
  background-image: radial-gradient(circle, rgba(92, 58, 18, 0.30) 1.4rpx, transparent 1.8rpx);
  background-size: 15rpx 15rpx;
  opacity: 0.5;
  mix-blend-mode: multiply;
  transform: rotate(-14deg);
}
.gloss {
  position: absolute; left: 26rpx; top: 16rpx;
  width: 62rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.55), transparent 70%);
  transform: rotate(-16deg);
  filter: blur(3rpx);
}
.peanut-shadow {
  position: absolute; left: 50%; bottom: -46rpx;
  width: 150rpx; height: 28rpx; margin-left: -75rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.62), transparent 72%);
  filter: blur(4rpx);
  animation: shadowPulse 4.2s ease-in-out infinite;
}
@keyframes shadowPulse {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(0.86); opacity: 0.45; }
}

.scan-bar {
  position: absolute; left: 50%; top: 16%;
  width: 300rpx; height: 3rpx; margin-left: -150rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 244, 214, 0.95), transparent);
  box-shadow: 0 0 24rpx rgba(255, 236, 190, 0.75);
  animation: scanMove 3.4s ease-in-out infinite;
  border-radius: 4rpx;
}
@keyframes scanMove {
  0% { transform: translateY(0); opacity: 0; }
  12% { opacity: 1; }
  88% { opacity: 1; }
  100% { transform: translateY(300rpx); opacity: 0; }
}

.hero-copy { text-align: center; margin-top: 4rpx; }
.kicker { display: block; font-size: 20rpx; letter-spacing: 6rpx; color: var(--gold-deep); }
.h1 {
  display: block; margin-top: 14rpx;
  font-size: 52rpx; font-weight: 700; letter-spacing: 2rpx;
  color: #fbf3e6;
  text-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.55);
}
.h2 { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--muted); letter-spacing: 1rpx; }

/* ============ 离线提示 ============ */
.offline {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 26rpx; margin-top: 26rpx;
  border-color: rgba(255, 122, 99, 0.35);
  background: linear-gradient(135deg, rgba(255, 122, 99, 0.14), rgba(255, 122, 99, 0.04));
}
.offline-body { flex: 1; padding-right: 20rpx; }
.offline-title { display: block; font-size: 26rpx; color: #ffb3a6; font-weight: 600; }
.offline-hint { display: block; margin-top: 6rpx; font-size: 21rpx; color: var(--muted); word-break: break-all; line-height: 1.5; }
.offline-btn {
  flex: 0 0 auto; padding: 12rpx 26rpx; border-radius: 999rpx;
  font-size: 23rpx; color: #2a1a12;
  background: linear-gradient(140deg, #f0d3a0, #cf9d55);
  font-weight: 600;
}

/* ============ 取样区 ============ */
.shoot {
  position: relative;
  height: 380rpx;
  border-radius: 28rpx;
  overflow: hidden;
}
.shoot-img { width: 100%; height: 100%; }
.shoot-empty {
  height: 100%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.target {
  position: relative;
  width: 260rpx; height: 260rpx;
  border-radius: 24rpx;
  background: radial-gradient(circle at 50% 45%, rgba(224, 187, 122, 0.10), transparent 70%);
  display: flex; align-items: center; justify-content: center;
}
.target-corner {
  position: absolute; width: 42rpx; height: 42rpx;
  border: 4rpx solid var(--gold);
  opacity: 0.85;
}
.target-corner.tl { left: 0; top: 0; border-right: 0; border-bottom: 0; border-radius: 14rpx 0 0 0; }
.target-corner.tr { right: 0; top: 0; border-left: 0; border-bottom: 0; border-radius: 0 14rpx 0 0; }
.target-corner.bl { left: 0; bottom: 0; border-right: 0; border-top: 0; border-radius: 0 0 0 14rpx; }
.target-corner.br { right: 0; bottom: 0; border-left: 0; border-top: 0; border-radius: 0 0 14rpx 0; }
.target-txt { font-size: 25rpx; color: #e8d9bf; letter-spacing: 1rpx; }
.shoot-hint { margin-top: 22rpx; font-size: 21rpx; color: var(--muted-2); }

.shoot-scan {
  position: absolute; left: 0; right: 0; top: 0; height: 6rpx;
  background: linear-gradient(90deg, transparent, rgba(88, 201, 163, 0.95), transparent);
  box-shadow: 0 0 26rpx rgba(88, 201, 163, 0.8);
  animation: shootScan 1.5s ease-in-out infinite;
}
@keyframes shootScan {
  0% { transform: translateY(0); }
  100% { transform: translateY(374rpx); }
}

/* ============ 三个入口 ============ */
.quick { display: flex; gap: 20rpx; margin-top: 22rpx; }
.quick-item {
  flex: 1;
  height: 148rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: 24rpx;
}
.quick-txt { margin-top: 14rpx; font-size: 24rpx; color: #e4d6c1; }

.miniico { position: relative; width: 52rpx; height: 44rpx; }
.mi-cam .p1 {
  position: absolute; left: 2rpx; top: 10rpx; width: 48rpx; height: 32rpx;
  border: 3rpx solid var(--gold); border-radius: 10rpx;
}
.mi-cam .p2 {
  position: absolute; left: 18rpx; top: 20rpx; width: 16rpx; height: 16rpx;
  border: 3rpx solid var(--gold); border-radius: 50%;
}
.mi-album .p1 {
  position: absolute; left: 2rpx; top: 6rpx; width: 48rpx; height: 36rpx;
  border: 3rpx solid var(--gold); border-radius: 8rpx;
}
.mi-album .p2 {
  position: absolute; left: 10rpx; top: 26rpx;
  width: 32rpx; height: 3rpx; background: var(--gold); transform: rotate(-16deg);
}
.mi-batch view { position: absolute; width: 18rpx; height: 18rpx; border: 3rpx solid var(--gold); border-radius: 6rpx; }
.mi-batch .p1 { left: 2rpx; top: 2rpx; }
.mi-batch .p2 { right: 2rpx; top: 2rpx; }
.mi-batch .p3 { left: 2rpx; bottom: 2rpx; }
.mi-batch .p4 { right: 2rpx; bottom: 2rpx; }

/* ============ 主按钮 ============ */
.cta {
  position: relative;
  margin-top: 34rpx;
  height: 116rpx;
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #f2d8a8 0%, #d8ac63 42%, #a97a33 100%);
  box-shadow: 0 20rpx 46rpx rgba(169, 122, 51, 0.35), inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
  overflow: hidden;
}
.cta-txt { font-size: 32rpx; font-weight: 700; color: #2b1d10; letter-spacing: 4rpx; }
.cta-icon { position: relative; width: 40rpx; height: 40rpx; margin-right: 18rpx; }
.cta-ring {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 50%;
  border: 4rpx solid rgba(43, 29, 16, 0.75);
  border-top-color: transparent;
  animation: spin2 1.6s linear infinite;
}
.cta-dot {
  position: absolute; left: 50%; top: 50%; width: 12rpx; height: 12rpx; margin: -6rpx 0 0 -6rpx;
  border-radius: 50%; background: #2b1d10;
}
@keyframes spin2 { to { transform: rotate(360deg); } }
.cta-glow {
  position: absolute; top: -40%; left: -40%; right: -40%; bottom: -40%;
  background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.55), transparent 45%);
  animation: sheen 4.5s ease-in-out infinite;
}
@keyframes sheen {
  0%, 100% { transform: translateX(-30%); opacity: 0.35; }
  50% { transform: translateX(30%); opacity: 0.7; }
}
.cta-busy { opacity: 0.72; }

/* ============ 分析中 ============ */
.analyzing {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(8, 7, 6, 0.66);
  display: flex; align-items: center; justify-content: center;
  z-index: 50;
}
.ana-card {
  position: relative;
  z-index: 3;
  width: 470rpx;
  padding: 42rpx 30rpx;
  display: flex; flex-direction: column; align-items: center;
  border-radius: 32rpx;
  background: rgba(20, 17, 13, 0.92);
  border: 1rpx solid var(--line-strong);
}
.ana-orbit {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 2rpx solid rgba(224, 187, 122, 0.35);
  display: flex; align-items: center; justify-content: center;
  animation: spin2 1.8s linear infinite;
}
.ana-core {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: radial-gradient(circle, #ffe9bf, #d8ac63 60%, transparent 72%);
  box-shadow: 0 0 30rpx rgba(224, 187, 122, 0.65);
}
.ana-title { margin-top: 26rpx; font-size: 28rpx; color: #f6ead6; }
.ana-sub { margin-top: 10rpx; font-size: 21rpx; color: var(--muted-2); }

/* ============ 批量结果 ============ */
.batch { display: flex; flex-wrap: wrap; gap: 18rpx; }
.batch-cell {
  position: relative;
  width: calc(33.33% - 12rpx);
  height: 220rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  background: #1a1510;
}
.batch-img { width: 100%; height: 100%; }
.batch-overlay {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 34rpx 0 12rpx;
  text-align: center;
  background: linear-gradient(to top, rgba(8, 7, 5, 0.92) 30%, rgba(8, 7, 5, 0));
}
.batch-tag { display: block; font-size: 21rpx; color: #f1e5d2; }
.batch-tag.tag-risk { color: #ff9a86; }
.batch-tag.tag-ok { color: #7fe0bd; }
.batch-conf { display: block; margin-top: 4rpx; font-size: 19rpx; color: var(--muted); }
.batch-cell.is-risk { border-color: rgba(255, 122, 99, 0.55); }
.batch-cell.is-ok { border-color: rgba(88, 201, 163, 0.42); }
.batch-cell.is-fail { border-color: rgba(160, 150, 140, 0.35); opacity: 0.65; }

/* ============ 结果 ============ */
.result {
  opacity: 0;
  transform: perspective(900rpx) rotateX(-12deg) translateY(24rpx);
  transition: opacity 0.5s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
}
.result-in { opacity: 1; transform: perspective(900rpx) rotateX(0) translateY(0); }

.verdict {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 32rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--line);
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
  box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, 0.38);
}
.verdict-left { flex: 1; padding-right: 20rpx; }
.verdict-k { display: block; font-size: 21rpx; letter-spacing: 4rpx; color: var(--muted-2); }
.verdict-v { display: block; margin-top: 12rpx; font-size: 46rpx; font-weight: 700; letter-spacing: 2rpx; }
.verdict-s { display: block; margin-top: 10rpx; font-size: 23rpx; color: var(--muted); }
.v-ok .verdict-v { color: var(--jade); }
.v-warn .verdict-v { color: var(--warn); }
.v-risk .verdict-v { color: var(--danger); }

.gauge { position: relative; width: 156rpx; height: 156rpx; flex: 0 0 auto; }
.gauge-ring {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 50%;
  -webkit-mask: radial-gradient(circle, transparent 58%, #000 60%);
  mask: radial-gradient(circle, transparent 58%, #000 60%);
}
.gauge-hole {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
}
.gauge-num { font-size: 38rpx; font-weight: 700; color: #f7eddc; }
.gauge-unit { font-size: 20rpx; color: var(--muted); margin-left: 2rpx; }

.bars { margin-top: 22rpx; padding: 28rpx; }
.bar-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.bar-k { width: 108rpx; font-size: 23rpx; color: var(--muted); }
.bar-track {
  flex: 1; height: 14rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  overflow: hidden;
  margin: 0 16rpx;
}
.bar-fill { height: 100%; border-radius: 999rpx; transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
.f-ok { background: linear-gradient(90deg, #2f8f72, #58c9a3); }
.f-warn { background: linear-gradient(90deg, #a8752a, #f0b429); }
.f-risk { background: linear-gradient(90deg, #a83b2b, #ff7a63); }
.bar-v { width: 76rpx; text-align: right; font-size: 22rpx; color: #e8dbc6; }
.bars-foot {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 8rpx; padding-top: 18rpx;
  border-top: 1rpx dashed rgba(217, 178, 106, 0.22);
}
.foot-k { font-size: 23rpx; color: var(--muted); }
.foot-v { font-size: 34rpx; font-weight: 700; }
.t-ok { color: var(--jade); }
.t-risk { color: var(--danger); }

.advice { display: flex; margin-top: 22rpx; padding: 26rpx; }
.adv-bar { width: 6rpx; border-radius: 4rpx; margin-right: 20rpx; flex: 0 0 auto; }
.adv-ok .adv-bar { background: linear-gradient(180deg, var(--jade), transparent); }
.adv-risk .adv-bar { background: linear-gradient(180deg, var(--danger), transparent); }
.adv-body { flex: 1; }
.adv-t { display: block; font-size: 25rpx; color: #f2e6d4; font-weight: 600; }
.adv-c { display: block; margin-top: 10rpx; font-size: 23rpx; color: var(--muted); line-height: 1.7; }

.meta { margin-top: 22rpx; padding: 26rpx; }
.meta-row { display: flex; justify-content: space-between; padding: 10rpx 0; }
.meta-k { font-size: 22rpx; color: var(--muted-2); }
.meta-v { font-size: 22rpx; color: #e3d5c0; }
.meta-note {
  display: block; margin-top: 16rpx; padding-top: 16rpx;
  border-top: 1rpx dashed rgba(217, 178, 106, 0.2);
  font-size: 20rpx; color: var(--muted-2); line-height: 1.7;
}

.share {
  margin-top: 26rpx;
  height: 92rpx; line-height: 92rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--line-strong);
  color: var(--gold);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.share::after { border: none; }

/* ============ 页脚 ============ */
.footer { margin-top: 48rpx; text-align: center; }
.footer-1 { display: block; font-size: 21rpx; color: var(--muted-2); letter-spacing: 2rpx; }
.footer-2 { display: block; margin-top: 8rpx; font-size: 19rpx; color: var(--muted-2); }


/* ===== 三态判定条 ===== */
.decision {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.04);
}
.dec-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  margin: 8rpx 18rpx 0 0;
  flex: 0 0 auto;
}
.dec-body { flex: 1; }
.dec-label { display: block; font-size: 27rpx; font-weight: 700; letter-spacing: 1rpx; }
.dec-hint { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--muted); line-height: 1.7; }

.dec-clear { border-color: rgba(88, 201, 163, 0.38); background: rgba(88, 201, 163, 0.08); }
.dec-clear .dec-dot { background: var(--jade); box-shadow: 0 0 14rpx rgba(88, 201, 163, 0.8); }
.dec-clear .dec-label { color: var(--jade); }

.dec-review { border-color: rgba(240, 180, 41, 0.38); background: rgba(240, 180, 41, 0.08); }
.dec-review .dec-dot { background: var(--warn); box-shadow: 0 0 14rpx rgba(240, 180, 41, 0.8); }
.dec-review .dec-label { color: var(--warn); }

.dec-unknown { border-color: rgba(255, 122, 99, 0.38); background: rgba(255, 122, 99, 0.08); }
.dec-unknown .dec-dot { background: var(--danger); box-shadow: 0 0 14rpx rgba(255, 122, 99, 0.8); }
.dec-unknown .dec-label { color: var(--danger); }


/* unknown 态：判定值置灰，避免与“无法判断”冲突 */
.v-hold .verdict-v { color: var(--muted) !important; }
.v-hold .gauge-ring { opacity: 0.55; }


/* ===== 结果卡动作区 ===== */
.actions { display: flex; gap: 18rpx; margin-top: 26rpx; }
.actions .share { flex: 1; margin-top: 0; }
.poster-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #2b1d10;
  font-weight: 700;
  background: linear-gradient(135deg, #f2d8a8, #d8ac63 55%, #a97a33);
  box-shadow: 0 14rpx 30rpx rgba(169, 122, 51, 0.28);
}

/* ===== 海报画布（离屏） ===== */
.poster-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 600rpx;
  height: 780rpx;
}

/* ===== 海报弹层 ===== */
.poster-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(6, 5, 4, 0.82);
  display: flex; align-items: center; justify-content: center;
  z-index: 90;
}
.poster-box { width: 620rpx; display: flex; flex-direction: column; align-items: center; }
.poster-img { width: 600rpx; border-radius: 24rpx; box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, 0.6); }
.poster-loading {
  width: 600rpx; height: 400rpx; border-radius: 24rpx;
  border: 1rpx dashed var(--line-strong);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--muted);
}
.poster-actions { display: flex; gap: 20rpx; margin-top: 26rpx; width: 100%; }
.pa {
  flex: 1; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 999rpx; font-size: 26rpx;
}
.pa-ghost { color: var(--muted); border: 1rpx solid var(--line-strong); }
.pa-main { color: #2b1d10; font-weight: 700; background: linear-gradient(135deg, #f2d8a8, #a97a33); }


/* ===== 批量汇总条 ===== */
.batch-sum {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 16rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
}
.bs-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bs-n { font-size: 34rpx; font-weight: 700; color: #f6ecdb; }
.bs-k { margin-top: 6rpx; font-size: 19rpx; color: var(--muted-2); }
.bs-sep { width: 1rpx; height: 46rpx; background: rgba(217, 178, 106, 0.16); }
.t-risk { color: var(--danger) !important; }
.t-ok { color: var(--jade) !important; }
.batch-warn {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  color: #ffb3a6;
  background: rgba(255, 122, 99, 0.1);
  border: 1rpx solid rgba(255, 122, 99, 0.28);
}


/* ===== 最近一次检测 ===== */
.last {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
}
.last-left { flex: 1; min-width: 0; }
.last-k { display: block; font-size: 20rpx; letter-spacing: 2rpx; color: var(--muted-2); }
.last-v { display: block; margin-top: 8rpx; font-size: 34rpx; font-weight: 700; }
.last-t { display: block; margin-top: 6rpx; font-size: 19rpx; color: var(--muted-2); }
.last-right { text-align: right; flex: 0 0 auto; }
.last-c { display: block; font-size: 30rpx; font-weight: 700; color: #e8dbc6; }
.last-h { display: block; margin-top: 8rpx; font-size: 19rpx; color: var(--muted-2); }


/* ================= 2026 动态层 ================= */

/* 雷达波纹：三圈错峰扩散 */
.ripple {
  position: absolute; left: 50%; top: 52%;
  width: 120rpx; height: 120rpx; margin: -60rpx 0 0 -60rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(224, 187, 122, 0.55);
  transform: rotateX(74deg);
  animation: rippleOut 4.2s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  opacity: 0;
}
.ripple.r2 { animation-delay: 1.4s; border-color: rgba(88, 201, 163, 0.45); }
.ripple.r3 { animation-delay: 2.8s; border-color: rgba(224, 187, 122, 0.35); }
@keyframes rippleOut {
  0%   { transform: rotateX(74deg) scale(0.35); opacity: 0; }
  12%  { opacity: 0.9; }
  100% { transform: rotateX(74deg) scale(3.2); opacity: 0; }
}

/* 旋转光束：一道扇形扫过全息盘 */
.sweep {
  position: absolute; left: 50%; top: 52%;
  width: 380rpx; height: 380rpx; margin: -190rpx 0 0 -190rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, rgba(255, 236, 190, 0.28), rgba(255, 236, 190, 0) 38%, transparent 100%);
  transform: rotateX(72deg);
  animation: spin 9s linear infinite;
  opacity: 0.55;
  mix-blend-mode: screen;
}

/* 悬浮粒子 */
.particles { position: absolute; left: 50%; top: 6%; width: 320rpx; height: 340rpx; margin-left: -160rpx; }
.pt {
  position: absolute; width: 6rpx; height: 6rpx; border-radius: 50%;
  background: rgba(255, 226, 176, 0.9);
  box-shadow: 0 0 10rpx rgba(255, 226, 176, 0.8);
  animation: rise 6s ease-in-out infinite;
  opacity: 0;
}
.pt.p1 { left: 12%; top: 78%; animation-delay: 0.0s; }
.pt.p2 { left: 26%; top: 86%; animation-delay: 0.8s; }
.pt.p3 { left: 38%; top: 72%; animation-delay: 1.6s; }
.pt.p4 { left: 52%; top: 90%; animation-delay: 2.4s; }
.pt.p5 { left: 64%; top: 76%; animation-delay: 3.2s; }
.pt.p6 { left: 76%; top: 88%; animation-delay: 4.0s; }
.pt.p7 { left: 84%; top: 70%; animation-delay: 4.8s; }
.pt.p8 { left: 44%; top: 96%; animation-delay: 5.4s; }
@keyframes rise {
  0%   { transform: translateY(0) scale(0.6); opacity: 0; }
  20%  { opacity: 0.9; }
  70%  { opacity: 0.7; }
  100% { transform: translateY(-170rpx) scale(1.1); opacity: 0; }
}

/* 主按钮流光描边 */
.cta-border {
  position: absolute; top: -2rpx; left: -2rpx; right: -2rpx; bottom: -2rpx;
  border-radius: 999rpx;
  background: conic-gradient(from 0deg, rgba(255,255,255,0.9), rgba(255,214,140,0.15) 25%, rgba(255,255,255,0.9) 50%, rgba(255,214,140,0.15) 75%, rgba(255,255,255,0.9));
  animation: spin 5s linear infinite;
  opacity: 0.75;
  z-index: 0;
}
.cta-border::after {
  content: '';
  position: absolute; top: 3rpx; left: 3rpx; right: 3rpx; bottom: 3rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2d8a8 0%, #d8ac63 42%, #a97a33 100%);
}
.cta-txt, .cta-icon { position: relative; z-index: 2; }

/* 结果卡呼吸光晕 */
.result { position: relative; }
.result-aura {
  position: absolute; left: -20rpx; right: -20rpx; top: -20rpx; bottom: -20rpx;
  border-radius: 40rpx;
  background: radial-gradient(60% 40% at 50% 0%, rgba(224, 187, 122, 0.16), transparent 70%);
  animation: auraPulse 5s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}
.result > view:not(.result-aura) { position: relative; z-index: 1; }
@keyframes auraPulse {
  0%, 100% { opacity: 0.45; transform: scale(0.99); }
  50%      { opacity: 0.9;  transform: scale(1.01); }
}

/* 背景细网格（缓慢漂移，营造仪器感） */
.grid-bg {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    repeating-linear-gradient(0deg, rgba(224, 187, 122, 0.05) 0 1rpx, transparent 1rpx 88rpx),
    repeating-linear-gradient(90deg, rgba(224, 187, 122, 0.05) 0 1rpx, transparent 1rpx 88rpx);
  animation: gridDrift 26s linear infinite;
  pointer-events: none;
  z-index: 0;
  opacity: 0.55;
}
@keyframes gridDrift {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(0, 88rpx, 0); }
}
.container > view:not(.grid-bg):not(.aurora):not(.analyzing):not(.poster-mask):not(.modal) { position: relative; z-index: 1; }


/* ================= 扫描遮罩 + 四步进度 ================= */
.scan-grid {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    repeating-linear-gradient(0deg, rgba(88, 201, 163, 0.10) 0 1rpx, transparent 1rpx 56rpx),
    repeating-linear-gradient(90deg, rgba(88, 201, 163, 0.10) 0 1rpx, transparent 1rpx 56rpx);
  animation: gridPulse 3s ease-in-out infinite;
  opacity: 0.7;
}
@keyframes gridPulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.85; } }

.scan-sweep {
  position: absolute; left: 0; right: 0; height: 160rpx;
  background: linear-gradient(180deg,
    rgba(88, 201, 163, 0) 0%,
    rgba(88, 201, 163, 0.18) 55%,
    rgba(160, 240, 210, 0.85) 96%,
    rgba(88, 201, 163, 0) 100%);
  box-shadow: 0 0 50rpx rgba(88, 201, 163, 0.55);
  animation: sweepDown 1.9s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
@keyframes sweepDown {
  0%   { top: -160rpx; opacity: 0; }
  15%  { opacity: 1; }
  85%  { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

.ana-steps { width: 100%; margin-top: 22rpx; }
.step-row {
  display: flex; align-items: center;
  padding: 9rpx 0;
  opacity: 0.32;
  transition: opacity 0.35s ease;
}
.step-row.on { opacity: 1; }
.sdot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--muted-2);
  margin-right: 16rpx;
  flex: 0 0 auto;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}
.step-row.on .sdot {
  background: var(--jade);
  box-shadow: 0 0 14rpx rgba(88, 201, 163, 0.9);
}
.stext { font-size: 23rpx; color: #e4d7c3; }

/* 批量格子错峰入场 */
.cell-in {
  animation: cellIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes cellIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.94); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}


/* ===== 质检画布（离屏） ===== */
.qc-canvas { position: fixed; left: -2000rpx; top: 0; width: 128rpx; height: 128rpx; }

/* ===== 风险分级光晕 ===== */
.result-aura { background: radial-gradient(60% 40% at 50% 0%, rgba(224,187,122,0.16), transparent 70%); }
.aura-ok .result-aura { background: radial-gradient(60% 40% at 50% 0%, rgba(88,201,163,0.20), transparent 72%); }
.aura-warn .result-aura { background: radial-gradient(60% 40% at 50% 0%, rgba(240,180,41,0.22), transparent 72%); }
.aura-risk .result-aura { background: radial-gradient(60% 40% at 50% 0%, rgba(255,122,99,0.24), transparent 72%); }

/* ===== 数字等宽，滚动不抖 ===== */
.gauge-num, .bar-v, .foot-v, .bs-n, .stat-n, .metric-n, .batch-conf {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

/* ===== 结果「为什么」 ===== */
.why { margin-top: 22rpx; padding: 0 26rpx; border-radius: 24rpx; overflow: hidden; }
.why-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0; }
.why-title { font-size: 25rpx; color: #f2e6d4; font-weight: 600; }
.why-arrow { font-size: 26rpx; color: var(--muted-2); transition: transform 0.25s ease; }
.why-arrow.up { transform: rotate(180deg); }
.why-body { padding-bottom: 26rpx; }
.why-row { display: flex; justify-content: space-between; padding: 9rpx 0; }
.why-k { font-size: 22rpx; color: var(--muted-2); }
.why-v { font-size: 22rpx; color: #e5d8c4; }
.why-rule { margin-top: 14rpx; padding: 18rpx 20rpx; border-radius: 16rpx; border: 1rpx solid var(--line); }
.why-rule.clear { border-color: rgba(88,201,163,0.35); background: rgba(88,201,163,0.07); }
.why-rule.review { border-color: rgba(240,180,41,0.35); background: rgba(240,180,41,0.07); }
.why-rule.unknown { border-color: rgba(255,122,99,0.35); background: rgba(255,122,99,0.07); }
.why-rule-t { display: block; font-size: 20rpx; color: var(--muted-2); letter-spacing: 1rpx; }
.why-rule-c { display: block; margin-top: 8rpx; font-size: 22rpx; color: #ece0cc; line-height: 1.6; }
.why-note { display: block; margin-top: 14rpx; font-size: 20rpx; color: var(--muted-2); line-height: 1.7; }

/* ===== 批量置信度竖条 ===== */
.conf-bar {
  position: absolute; right: 0; top: auto; bottom: 0;
  width: 6rpx; border-radius: 3rpx 0 0 0;
  opacity: 0.9;
}
.cb-risk { background: linear-gradient(180deg, rgba(255,122,99,0.35), #ff7a63); }
.cb-ok { background: linear-gradient(180deg, rgba(88,201,163,0.35), #58c9a3); }


/* ===== 最像的历史样本 ===== */
.nb { margin-top: 22rpx; padding: 24rpx 26rpx; border-radius: 24rpx; }
.nb-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; }
.nb-title { font-size: 24rpx; color: #f2e6d4; font-weight: 600; }
.nb-sub { font-size: 19rpx; color: var(--muted-2); }
.nb-row { display: flex; }
.nb-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.nb-img { width: 152rpx; height: 152rpx; border-radius: 16rpx; border: 1rpx solid var(--line); }
.nb-sim { margin-top: 10rpx; font-size: 22rpx; color: var(--gold); font-variant-numeric: tabular-nums; }
.nb-label { margin-top: 2rpx; font-size: 19rpx; color: var(--muted-2); }

.nb-ano { margin-top: 22rpx; }
.nb-ano-head { display: flex; justify-content: space-between; align-items: baseline; }
.nb-ano-k { font-size: 22rpx; color: var(--muted-2); }
.nb-ano-v { font-size: 30rpx; color: #f0e4d2; font-variant-numeric: tabular-nums; font-weight: 700; }
.nb-ano-track { margin-top: 10rpx; height: 8rpx; border-radius: 4rpx; background: rgba(255,255,255,0.08); overflow: hidden; }
.nb-ano-fill { height: 100%; border-radius: 4rpx; }
.ano-low { background: linear-gradient(90deg, #3f8f74, #58c9a3); }
.ano-mid { background: linear-gradient(90deg, #b78a43, #f0b429); }
.ano-high { background: linear-gradient(90deg, #c85a44, #ff7a63); }
.nb-ano-note { display: block; margin-top: 10rpx; font-size: 19rpx; color: var(--muted-2); line-height: 1.6; }


/* ===== 二分类：p(mold) 概率条 + 阈值刻度 ===== */
.pm-head { display: flex; align-items: baseline; justify-content: space-between; margin: 6rpx 0 12rpx; }
.pm-k { font-size: 24rpx; color: var(--muted); }
.pm-sub { font-size: 19rpx; color: var(--muted-2); }
.pm-v { font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.pm-bad { color: var(--danger); }
.pm-good { color: var(--jade); }
.pm-track { position: relative; height: 18rpx; border-radius: 9rpx; background: rgba(255,255,255,0.08); overflow: hidden; }
.pm-fill { height: 100%; border-radius: 9rpx; transition: width 0.6s cubic-bezier(0.22,1,0.36,1); }
.pm-fill-bad { background: linear-gradient(90deg, #8c3a2b, #ff7a63); }
.pm-fill-good { background: linear-gradient(90deg, #2f6f5b, #58c9a3); }
.pm-thr {
  position: absolute; top: -4rpx; bottom: -4rpx; width: 3rpx;
  background: var(--gold); box-shadow: 0 0 10rpx rgba(224,187,122,0.9);
}
.pm-scale { display: flex; justify-content: space-between; margin-top: 10rpx; }
.pm-s { font-size: 19rpx; color: var(--muted-2); font-variant-numeric: tabular-nums; }
.pm-thr-label { color: var(--gold); }
.pm-note { margin-top: 10rpx; font-size: 19rpx; color: var(--muted-2); line-height: 1.6; }
